[binaries]
c = 'i586-pc-msdosdjgpp-gcc'
ar = 'i586-pc-msdosdjgpp-ar'
strip = 'i586-pc-msdosdjgpp-strip'

[properties]
needs_exe_wrapper = true

[host_machine]
system = 'dos'
cpu_family = 'x86'
cpu = 'i586'
endian = 'little'

[built-in options]
default_library = 'static'
b_staticpic = false
c_args = ['-Wno-attributes']
c_std = 'gnu11'
nasm_args = ['-f', 'coff']
